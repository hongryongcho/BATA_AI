# BATAGOTA Family Photo Service
# This folder is intentionally isolated from the existing BATAGOTA services.
# Do not change the 00_BATAGOTA / 01_BATA_STOCK ports or scripts.

IMMICH_HOST=picture.batagota.com
IMMICH_PORT=2283
IMMICH_TRUSTED_PROXIES=172.16.0.0/12
DB_HOST=immich-db
DB_PORT=5432
DB_USERNAME=immich
DB_PASSWORD=immich
DB_DATABASE_NAME=immich
REDIS_HOSTNAME=immich-redis

# Optional admin account setup (set these in real .env after first run)
# IMMICH_ADMIN_EMAIL=admin@batagota.com
# IMMICH_ADMIN_PASSWORD=change-me-strong-password
